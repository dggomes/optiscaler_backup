<Window x:Class="OptiScalerBackup.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="OptiScaler Backup" Width="1240" Height="820" MinWidth="1000" MinHeight="680"
        WindowStartupLocation="CenterScreen" Background="#F4F2ED" FontFamily="Segoe UI" FontSize="14"
        Closing="Window_Closing">
    <Window.Resources>
        <SolidColorBrush x:Key="Ink" Color="#172125"/>
        <SolidColorBrush x:Key="Muted" Color="#66726F"/>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#FFFFFF"/><Setter Property="Foreground" Value="{StaticResource Ink}"/>
            <Setter Property="BorderBrush" Value="#D6DBD5"/><Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="15,10"/><Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="Cursor" Value="Hand"/><Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
                <Border x:Name="Surface" CornerRadius="6" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                    <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="#77886A"/><Setter TargetName="Surface" Property="Opacity" Value="0.86"/></Trigger>
                    <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Surface" Property="BorderThickness" Value="2"/><Setter TargetName="Surface" Property="BorderBrush" Value="#536E3B"/></Trigger>
                    <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Surface" Property="Opacity" Value="0.4"/></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="Primary" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#D7EEA5"/><Setter Property="BorderBrush" Value="#C5DD91"/>
        </Style>
        <Style TargetType="TextBox"><Setter Property="Padding" Value="10"/><Setter Property="BorderBrush" Value="#CAD1C9"/><Setter Property="BorderThickness" Value="1"/><Setter Property="VerticalContentAlignment" Value="Center"/></Style>
        <Style TargetType="DataGrid">
            <Setter Property="AutoGenerateColumns" Value="False"/><Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="IsReadOnly" Value="True"/><Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="HorizontalGridLinesBrush" Value="#E6E9E2"/><Setter Property="BorderThickness" Value="0"/>
            <Setter Property="RowBackground" Value="#FFFFFF"/><Setter Property="AlternatingRowBackground" Value="#F9FAF6"/>
            <Setter Property="HeadersVisibility" Value="Column"/><Setter Property="RowHeight" Value="40"/>
            <Setter Property="ColumnHeaderStyle"><Setter.Value><Style TargetType="DataGridColumnHeader">
                <Setter Property="Background" Value="#EAEDE5"/><Setter Property="Padding" Value="12"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="BorderThickness" Value="0"/>
            </Style></Setter.Value></Setter>
        </Style>
        <Style TargetType="TabItem"><Setter Property="Padding" Value="16,10"/><Setter Property="FontWeight" Value="SemiBold"/></Style>
    </Window.Resources>
    <Grid x:Name="Shell">
        <Grid.ColumnDefinitions><ColumnDefinition Width="305"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <Border Background="#172125">
            <Grid Margin="22,27,22,20">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <StackPanel>
                    <TextBlock Text="OPTISCALER" Foreground="#D7EEA5" FontSize="12" FontWeight="Bold" FontFamily="Consolas"/>
                    <TextBlock Text="Backup library" Foreground="#F4F2ED" FontSize="28" FontFamily="Bahnschrift" Margin="0,6,0,4"/>
                    <TextBlock x:Name="LibraryCount" Foreground="#AFBCB3" Margin="0,0,0,25"/>
                </StackPanel>
                <TextBox x:Name="SearchBox" Grid.Row="1" TextChanged="Search_Changed" ToolTip="Search game names" AutomationProperties.Name="Search games" Background="#263338" Foreground="#FFFFFF" BorderBrush="#53635C" CaretBrush="#D7EEA5"/>
                <TextBlock Grid.Row="2" Text="TYPE A FEW LETTERS TO FIND A GAME" FontFamily="Consolas" FontSize="10" Foreground="#9CAD9E" Margin="1,8,0,15"/>
                <ListBox x:Name="GameList" Grid.Row="3" SelectionChanged="Game_Selected" Background="Transparent" BorderThickness="0" Foreground="#F4F2ED" ScrollViewer.HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch" AutomationProperties.Name="Games">
                    <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem">
                        <Setter Property="Margin" Value="0,0,0,7"/><Setter Property="Padding" Value="11"/>
                        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem">
                            <Border x:Name="Tile" CornerRadius="5" Padding="{TemplateBinding Padding}" Background="Transparent"><ContentPresenter/></Border>
                            <ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter TargetName="Tile" Property="Background" Value="#34453B"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Tile" Property="BorderBrush" Value="#759367"/><Setter TargetName="Tile" Property="BorderThickness" Value="1"/></Trigger></ControlTemplate.Triggers>
                        </ControlTemplate></Setter.Value></Setter>
                    </Style></ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate><DataTemplate><StackPanel>
                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextWrapping="Wrap" FontSize="15"/>
                        <TextBlock Text="{Binding Detail}" Foreground="#B5C3B7" FontSize="11" Margin="0,5,0,0"/>
                    </StackPanel></DataTemplate></ListBox.ItemTemplate>
                </ListBox>
                <StackPanel Grid.Row="4" Margin="0,16,0,0">
                    <Button Content="Scan installed games" Style="{StaticResource Primary}" Click="Scan_Click" Margin="0,0,0,8"/>
                    <Button Content="Add game / scan folder" Click="AddGame_Click" Margin="0,0,0,8"/>
                    <Button Content="Open backups" Click="OpenBackups_Click" Margin="0,0,0,0"/>
                </StackPanel>
            </Grid>
        </Border>
        <Grid Grid.Column="1" Margin="35,29,35,22">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <Grid Margin="0,0,0,24"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel><TextBlock Text="YOUR GAMES. YOUR WORKING SETTINGS." FontFamily="Consolas" Foreground="{StaticResource Muted}" FontSize="11"/><TextBlock Text="Keep a version worth coming back to." FontFamily="Bahnschrift" FontSize="21" Foreground="{StaticResource Ink}" Margin="0,7,15,0"/></StackPanel>
                <Button Grid.Column="1" Content="Release downloads ↗" Click="Releases_Click" VerticalAlignment="Top" Margin="0"/>
            </Grid>
            <Grid Grid.Row="1">
                <Border x:Name="EmptyState" Background="#FFFFFF" CornerRadius="9" Padding="38">
                    <StackPanel VerticalAlignment="Center"><TextBlock Text="Start with your library." FontFamily="Bahnschrift" FontSize="36" Foreground="{StaticResource Ink}"/><TextBlock Text="Scan your installed launchers, or add a game folder.&#10;Select a game to review files, save versions and install packages." TextWrapping="Wrap" Foreground="{StaticResource Muted}" FontSize="16" Margin="0,17,0,0" LineHeight="27"/></StackPanel>
                </Border>
                <Grid x:Name="GamePanel" Visibility="Collapsed">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <StackPanel Margin="0,0,0,21"><TextBlock x:Name="SourceText" FontFamily="Consolas" Foreground="{StaticResource Muted}" FontSize="11"/><TextBlock x:Name="GameTitle" FontFamily="Bahnschrift" FontSize="36" Foreground="{StaticResource Ink}" TextWrapping="Wrap" Margin="0,6,0,9"/><TextBlock x:Name="PathText" Foreground="{StaticResource Muted}" TextWrapping="Wrap"/><TextBlock x:Name="AvailabilityText" Foreground="#8A4928" Margin="0,5,0,0"/></StackPanel>
                    <Border Grid.Row="1" Background="#E6EDDA" CornerRadius="7" Padding="18" Margin="0,0,0,23">
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="One review. Everything in its place." FontWeight="SemiBold" Foreground="{StaticResource Ink}"/><TextBlock x:Name="SummaryText" Foreground="#56674F" Margin="0,5,0,0" TextWrapping="Wrap"/></StackPanel><Button Grid.Column="1" Content="Review managed files" Style="{StaticResource Primary}" Click="Detect_Click" Margin="12,0,0,0" VerticalAlignment="Center"/></Grid>
                    </Border>
                    <TabControl Grid.Row="2" Background="#FFFFFF" BorderBrush="#DDE2D6" Padding="17">
                        <TabItem Header="Versions"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                            <WrapPanel Margin="0,0,0,17"><Button Content="Save version" Style="{StaticResource Primary}" Click="Capture_Click"/><Button Content="Preview restore" Click="Restore_Click"/><Button Content="Rename" Click="RenameSnapshot_Click"/></WrapPanel>
                            <DataGrid Grid.Row="1" x:Name="SnapshotList" SelectionMode="Single" AutomationProperties.Name="Saved versions"><DataGrid.Columns><DataGridTextColumn Header="Version" Binding="{Binding Name}" Width="*"/><DataGridTextColumn Header="Kind" Binding="{Binding Kind}" Width="100"/><DataGridTextColumn Header="Saved" Binding="{Binding Created}" Width="150"/></DataGrid.Columns></DataGrid>
                        </Grid></TabItem>
                        <TabItem Header="Managed files"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><TextBlock Text="Only recorded paths are restored. Explicit absence removes a file; unknown paths are preserved." Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,0,15"/><DataGrid Grid.Row="1" x:Name="ManagedList" AutomationProperties.Name="Managed files"><DataGrid.Columns><DataGridTextColumn Header="File" Binding="{Binding Path}" Width="*"/><DataGridTextColumn Header="Location" Binding="{Binding Location}" Width="130"/></DataGrid.Columns></DataGrid></Grid></TabItem>
                        <TabItem Header="Packages"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                            <WrapPanel Margin="0,0,0,15"><Button Content="Import ZIP" Style="{StaticResource Primary}" Click="Import_Click"/><Button Content="Preview install" Click="Install_Click"/><Button Content="Rename" Click="RenamePackage_Click"/></WrapPanel>
                            <DataGrid Grid.Row="1" x:Name="PackageList" SelectionMode="Single" AutomationProperties.Name="Packages"><DataGrid.Columns><DataGridTextColumn Header="Package" Binding="{Binding Name}" Width="*"/><DataGridTextColumn Header="Version" Binding="{Binding Version}" Width="100"/><DataGridTextColumn Header="Files" Binding="{Binding Files.Count}" Width="65"/></DataGrid.Columns></DataGrid>
                            <DockPanel Grid.Row="2" Margin="0,18,0,12"><Button Content="Preview rollback" DockPanel.Dock="Right" Click="Rollback_Click" Margin="0"/><TextBlock Text="ACTIVE INSTALLATIONS" FontFamily="Consolas" FontSize="11" Foreground="{StaticResource Muted}" VerticalAlignment="Center"/></DockPanel>
                            <DataGrid Grid.Row="3" x:Name="InstallationList" SelectionMode="Single" AutomationProperties.Name="Active installations"><DataGrid.Columns><DataGridTextColumn Header="Package" Binding="{Binding Name}" Width="*"/><DataGridTextColumn Header="Installed" Binding="{Binding Created}" Width="150"/></DataGrid.Columns></DataGrid>
                        </Grid></TabItem>
                    </TabControl>
                </Grid>
            </Grid>
            <StackPanel Grid.Row="2" Margin="0,18,0,0"><ProgressBar x:Name="BusyProgress" IsIndeterminate="True" Height="3" Visibility="Collapsed" Margin="0,0,0,9" Foreground="#6C853E"/><TextBlock x:Name="StatusText" Text="Ready. Backups stay local." Foreground="{StaticResource Muted}" FontSize="12" TextWrapping="Wrap"/></StackPanel>
        </Grid>
    </Grid>
</Window>
