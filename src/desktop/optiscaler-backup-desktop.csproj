<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <AssemblyName>optibackup-ui</AssemblyName>
    <RootNamespace>OptiScalerBackup.Desktop</RootNamespace>
    <StartupObject>OptiScalerBackup.Desktop.App</StartupObject>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../core/OptiScalerBackup.Core.csproj" />
    <ProjectReference Include="../windows/OptiScalerBackup.Windows.csproj" />
  </ItemGroup>
</Project>
